/* ============================================================
   全局样式 —— 视觉移植自旧项目 Turtle_Soup
   浅色底 + 翡翠绿主色(#059669) + 琥珀色点缀(#f59e0b)
   ============================================================ */

page {
  background:
    radial-gradient(circle at 15% 20%, rgba(5, 150, 105, 0.07), transparent 30%),
    radial-gradient(circle at 85% 70%, rgba(245, 158, 11, 0.07), transparent 30%),
    #f3f4f6;
  color: #111827;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue',
    'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 卡片 ---------- */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 20rpx;
}

/* ---------- 按钮 ---------- */
.btn-primary {
  background: #059669;
  color: #ffffff;
  border-radius: 16rpx;
  font-weight: 600;
  font-size: 30rpx;
  line-height: 88rpx;
  padding: 0;
  box-shadow: 0 8rpx 20rpx rgba(5, 150, 105, 0.25);
}
.btn-primary::after { border: none; }
.btn-primary[disabled] {
  background: #a7d3c4 !important;
  color: #ffffff !important;
  box-shadow: none;
}

.btn-ghost {
  background: #ffffff;
  color: #059669;
  border: 2rpx solid #059669;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
  padding: 0;
}
.btn-ghost::after { border: none; }

.btn-plain {
  background: #f1f5f9;
  color: #334155;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  padding: 0;
}
.btn-plain::after { border: none; }

.btn-danger {
  background: #ef4444;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
  padding: 0;
}
.btn-danger::after { border: none; }

.btn-sm {
  font-size: 24rpx !important;
  line-height: 60rpx !important;
  padding: 0 24rpx !important;
  display: inline-block;
}

/* ---------- 表单 ---------- */
.label {
  font-size: 26rpx;
  color: #4b5563;
  font-weight: 600;
  margin-bottom: 12rpx;
  display: block;
}

.input {
  background: #f8fafc;
  border: 2rpx solid #cbd5e1;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  width: 100%;
  box-sizing: border-box;
}

.textarea {
  background: #f8fafc;
  border: 2rpx solid #cbd5e1;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  min-height: 220rpx;
  box-sizing: border-box;
}

/* ---------- 单行输入框容器（外框负责外观 / flex 垂直居中，原生 input 不支持 flex） ---------- */
.field {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border: 2rpx solid #cbd5e1;
  border-radius: 16rpx;
  box-sizing: border-box;
}
.field-inner {
  flex: 1;
  height: 100%;
  min-width: 0;
  font-size: 30rpx;
  color: #111827;
}

/* ---------- 标签 / 辅助 ---------- */
.tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #059669;
  font-weight: 600;
}
.tag-amber { background: #fffbeb; color: #b45309; }
.tag-gray  { background: #f1f5f9; color: #64748b; }

.muted { color: #6b7280; font-size: 24rpx; }

.divider {
  display: flex;
  align-items: center;
  color: #9ca3af;
  font-size: 24rpx;
  margin: 28rpx 0;
}
.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: #e5e7eb;
  margin: 0 20rpx;
}

/* ---------- 弹窗 ---------- */
.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.55);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  width: 86%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  text-align: center;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
.modal-actions button { flex: 1; }

/* ============================================================
   深色模式适配（跟随系统「深色模式」自动生效，浅色配置不受影响）
   ============================================================ */
@media (prefers-color-scheme: dark) {
  page {
    background:
      radial-gradient(circle at 15% 20%, rgba(16, 185, 129, 0.10), transparent 30%),
      radial-gradient(circle at 85% 70%, rgba(245, 158, 11, 0.08), transparent 30%),
      #0f172a;
    color: #e5e7eb;
  }

  /* 卡片 */
  .card {
    background: #1e293b;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.35);
  }
  .card-title { color: #e5e7eb; }

  /* 按钮 */
  .btn-primary { background: #059669; }
  .btn-primary[disabled] {
    background: #334155 !important;
    color: #64748b !important;
  }
  .btn-ghost {
    background: transparent;
    color: #34d399;
    border-color: #34d399;
  }
  .btn-plain { background: #334155; color: #cbd5e1; }

  /* 表单 */
  .label { color: #94a3b8; }
  .input,
  .textarea {
    background: #0f172a;
    border-color: #334155;
    color: #e5e7eb;
  }
  .field {
    background: #0f172a;
    border-color: #334155;
  }
  .field-inner { color: #e5e7eb; }

  /* 标签 / 辅助 */
  .tag { background: rgba(16, 185, 129, 0.16); color: #34d399; }
  .tag-amber { background: rgba(245, 158, 11, 0.16); color: #fbbf24; }
  .tag-gray { background: #334155; color: #94a3b8; }
  .muted { color: #94a3b8; }
  .divider { color: #94a3b8; }
  .divider::before,
  .divider::after { background: #334155; }

  /* 弹窗 */
  .mask { background: rgba(0, 0, 0, 0.65); }
  .modal { background: #1e293b; }
  .modal-title { color: #e5e7eb; }
}