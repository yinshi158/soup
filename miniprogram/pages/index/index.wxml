<view class="page">

  <!-- 顶部品牌区 -->
  <view class="hero" style="height: 362rpx; display: block; box-sizing: border-box; left: 0rpx; top: 0rpx">
    <view class="hero-emoji" style="height: 170rpx; display: block; box-sizing: border-box">🐢</view>
    <view class="hero-title" style="height: 79rpx; display: block; box-sizing: border-box">海龟汤仙人</view>
    <view class="hero-sub">沉浸式推理聊天室 · 多人联机</view>
  </view>

  <!-- 玩法说明 -->
  <view class="card" style="height: 410rpx; display: block; box-sizing: border-box">
    <view class="card-title">怎么玩？</view>
    <view class="rule">
      <text class="rule-num">1</text>
      <text>创建房间后，AI 主持人端上一碗「汤面」（谜题）</text>
    </view>
    <view class="rule">
      <text class="rule-num">2</text>
      <text>玩家提问，AI 只会回答「是 / 不是 / 不重要」</text>
    </view>
    <view class="rule">
      <text class="rule-num">3</text>
      <text>拼出真相后点「故事还原」，AI 判定是否过关</text>
    </view>
    <view class="rule">
      <text class="rule-num">4</text>
      <text>把 6 位数字房间码发给朋友，随时加入一起推理</text>
    </view>
  </view>

  <!-- 创建 / 加入 -->
  <view class="card">
    <label class="label">你的昵称</label>
    <view class="field">
      <input class="field-inner" placeholder="比如：汤达人" maxlength="12"
        value="{{nickname}}" bindinput="onNickname" />
    </view>

    <button class="btn-primary create-btn" loading="{{creating}}"
      disabled="{{creating}}" bindtap="createRoom" style="width: 377rpx; display: block; box-sizing: border-box; left: 0rpx; top: 0rpx">创建房间（随机出一道题）</button>

    <view class="divider">已经有房间码？</view>

    <label class="label">6 位数字房间码</label>
    <view class="join-row">
      <view class="field join-field">
        <input class="field-inner" type="number" placeholder="如 482913" maxlength="6"
          value="{{joinCode}}" bindinput="onCode" />
      </view>
      <button class="btn-ghost join-btn" loading="{{joining}}"
        disabled="{{joining}}" bindtap="joinRoom" style="width: 248rpx; display: block; box-sizing: border-box; left: 0rpx; top: 0rpx">加入</button>
    </view>
  </view>

  <!-- 故事广场入口 -->
  <view class="card resume-card" bindtap="goPlaza">
    <view class="resume-left">
      <view class="resume-title">故事广场</view>
      <view class="muted">浏览大家发布的海龟汤，还能一键开局</view>
    </view>
    <text class="resume-arrow">›</text>
  </view>

  <!-- 继续上次房间 -->
  <view class="card resume-card" wx:if="{{lastRoom}}" bindtap="resumeRoom">
    <view class="resume-left">
      <view class="resume-title">继续上次的房间</view>
      <view class="muted">房间码 {{lastRoom.code}} · 昵称 {{lastRoom.nickname}}</view>
    </view>
    <text class="resume-arrow">›</text>
  </view>

  <view class="footer muted">逻辑移植自 Turtle_Soup · 故事广场与管理后台将在第二期加入</view>
</view>